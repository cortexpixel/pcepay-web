option_settings:
  - namespace: aws:elasticbeanstalk:container:nodejs
    option_name: NodeVersion
    value: 22

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NODE_ENV
    value: production

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: AWS_SES_REGION
    value: ""

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: AWS_ACCESS_KEY_ID
    value: ""

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: AWS_SECRET_ACCESS_KEY
    value: ""

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: SES_FROM_EMAIL
    value: ""

  - namespace: aws:elasticbeanstalk:application:environment
    option_name: SES_TO_EMAIL
    value: ""

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/01_npm_prune.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Ensure production deps only after build
      if [ -f /var/app/current/package.json ]; then
        cd /var/app/current || exit 0
        npm prune --production || true
      fi
